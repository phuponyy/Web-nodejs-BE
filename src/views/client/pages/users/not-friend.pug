extends ../../layout/default
include ../../mixins/box-head

block main
    .container.my-3

        include ../../partials/list-btn-users.pug

        .row
            .col-12
                +box-head("Danh sách người dùng")

        .row
            each user in users
                .col-3
                    div(class="box-user")
                        div(class="inner-avatar")
                            img(
                                src=(user.avatar ? user.avatar : "/images/PN.png")
                                alt=user.fullName
                            )
                        div(class="inner-info")
                            div(class="inner-name") #{user.fullName}
                            div(class="inner-buttons")
                                button(
                                    class="btn btn-primary btn-sm mr-1"
                                    btn-add-friend=user.id
                                ) Kết bạn
                                button(
                                    class="btn btn-danger btn-sm"
                                    btn-cancel-friend=user.id
                                ) Huỷ